{
  "schemaVersion": "host-pack.v1",
  "hostId": "asp-fwt-common-front",
  "mode": "legacy-host-compatible",
  "sourceDoc": "docs/business-lines/after-sales/asp-fwt-common-front.md",
  "stableConstraints": {
    "runtime": {
      "reactHost": "legacy-react-module-federation-remote",
      "rootHiuiPackage": "@hi-ui/hiui",
      "rootHiuiMajor": 3,
      "hiui5Alias": "hiui5"
    },
    "navigation": {
      "globalNavigationOwner": "host",
      "leftNavigationOwner": "host",
      "businessPageMayDeclarePrimaryNavigation": false
    },
    "mounting": {
      "contentMountOwner": "host",
      "businessPageScope": "right-content-only",
      "isolatedStandardShellAllowedForDelivery": false
    },
    "ownership": {
      "mustResolveBeforeBusinessFields": [
        "content-slot",
        "white-body",
        "outer-padding",
        "main-scroll"
      ],
      "singleOwnerRequired": true
    }
  },
  "adapterConsumption": {
    "request": {
      "status": "not-required",
      "source": "host-pack:runtime-does-not-consume-request-adapter",
      "notes": "Page-level apiBinding is generated as page.request.ts when required; HiuiLegacyPage does not call a host request adapter during shell rendering."
    },
    "message": {
      "status": "not-required",
      "source": "host-pack:runtime-does-not-consume-message-adapter",
      "notes": "HiuiLegacyPage does not call a host message bridge."
    },
    "permission": {
      "status": "not-required",
      "source": "host-pack:runtime-does-not-consume-permission-adapter",
      "notes": "Permission-sensitive visibility must be supplied through typed slots or page-level logic before rendering."
    },
    "route": {
      "status": "not-required",
      "source": "host-pack:host-owns-route-shell",
      "notes": "The legacy host owns route mounting; generated pages render inside the existing host route."
    },
    "theme": {
      "status": "not-required",
      "source": "host-pack:runtime-uses-local-style-boundary",
      "notes": "HiuiLegacyPage uses src/hiui-runtime/styles.css and the data-hiui-page-root style boundary instead of a host theme adapter."
    }
  },
  "pageTypeOverrides": {
    "table-stat": {
      "mandatoryRegions": [
        "header",
        "white-body",
        "stat-section",
        "query-filter",
        "table",
        "pagination"
      ],
      "mustNot": [
        "translate-to-PageTable-tabs",
        "translate-to-header-numbers-list",
        "drop-real-stat-section",
        "drop-real-QueryFilter",
        "open-another-layout"
      ]
    }
  },
  "generationPolicy": {
    "defaultLegacyEntry": "typical-page:legacy:init -> typical-page:legacy:new|rewrite",
    "writeSrcPageComponentsByDefault": false,
    "businessPageWrites": [
      "page.instance.tsx",
      "page.slots.ts",
      "page.request.ts"
    ]
  }
}
