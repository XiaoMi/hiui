{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hiui-design.local/schemas/runtime-provider.schema.json",
  "title": "HiUI Legacy Runtime Provider Contract",
  "type": "object",
  "required": ["schemaVersion", "mode", "provider", "pageTypes"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": "hiui-runtime-provider-contract.v1" },
    "mode": { "const": "legacy-host-compatible" },
    "provider": { "enum": ["official-shells", "project-runtime-adapter"] },
    "reason": { "type": "string" },
    "pageTypes": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["status", "runtimeEntry", "componentName", "canonicalShell", "consumesTypedSlots", "regionMarkers"],
        "additionalProperties": false,
        "properties": {
          "status": { "enum": ["ready", "blocked"] },
          "runtimeEntry": { "type": "string" },
          "componentName": { "type": "string" },
          "canonicalShell": { "type": "string" },
          "consumesTypedSlots": { "const": true },
          "regionMarkers": {
            "type": "array",
            "items": { "type": "string" }
          },
          "blockingReasons": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    }
  }
}
