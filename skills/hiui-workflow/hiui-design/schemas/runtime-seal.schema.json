{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hiui-design/runtime-seal.schema.json",
  "type": "object",
  "required": [
    "schemaVersion",
    "mode",
    "runtimeCoreVersion",
    "rulesVersion",
    "sourceHashAlgorithm",
    "generatedAt",
    "sealedCoreFiles",
    "allowedExtensionGlobs",
    "canonicalShellByPageType",
    "criticalImportsByPageType"
  ],
  "properties": {
    "schemaVersion": { "const": "runtime-seal.v1" },
    "mode": { "const": "legacy-host-compatible" },
    "runtimeCoreVersion": { "type": "string", "minLength": 1 },
    "rulesVersion": { "type": "string", "minLength": 1 },
    "sourceHashAlgorithm": { "const": "sha256" },
    "sourceSkillRoot": { "type": "string" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "sealedCoreFiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["targetPath", "sourcePath", "sha256", "required"],
        "properties": {
          "targetPath": {
            "type": "string",
            "minLength": 1,
            "pattern": "^src/hiui-runtime/"
          },
          "sourcePath": {
            "type": "string",
            "minLength": 1,
            "pattern": "^runtime/legacy/src/"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "required": { "type": "boolean" }
        },
        "additionalProperties": false
      }
    },
    "allowedExtensionGlobs": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "canonicalShellByPageType": {
      "type": "object",
      "required": ["table-basic", "tree-table", "table-stat", "tree-split"],
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "criticalImportsByPageType": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["module", "exportName"],
          "properties": {
            "module": { "type": "string", "minLength": 1 },
            "exportName": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        }
      }
    }
  },
  "additionalProperties": false
}
