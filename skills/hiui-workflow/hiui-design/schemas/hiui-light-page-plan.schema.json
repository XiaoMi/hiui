{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hiui-design/hiui-light-page-plan.schema.json",
  "type": "object",
  "required": [
    "schemaVersion",
    "mode",
    "pageType",
    "pagePath",
    "writeScope",
    "dataMode",
    "validationLevel",
    "createdAt",
    "source"
  ],
  "properties": {
    "schemaVersion": { "const": "hiui-light-page-plan.v1" },
    "mode": {
      "enum": [
        "legacy-host-compatible",
        "rules-only",
        "host-integration"
      ]
    },
    "pageType": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "pagePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+"
    },
    "writeScope": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+"
      }
    },
    "dataMode": {
      "enum": ["mock", "real", "hybrid", "unknown"]
    },
    "validationLevel": {
      "enum": ["preview", "delivery"]
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "type": "object",
      "required": ["type", "summary"],
      "properties": {
        "type": {
          "enum": ["ai-generated", "script-derived", "manual", "migration"]
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "requestId": {
          "type": "string"
        },
        "evidenceRefs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
