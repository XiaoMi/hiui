{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hiui-design.local/schemas/sync-profile-contract.schema.json",
  "title": "hiui-design sync profile contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "profiles"],
  "properties": {
    "schemaVersion": { "const": "hiui-design-sync-profile-contracts.v1" },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/profile" }
    }
  },
  "$defs": {
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "not": { "pattern": "(^/|(^|/)\\.\\.(/|$))" }
    },
    "scriptMap": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/relativePath" }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profileId",
        "mode",
        "syncProfile",
        "syncManifestPath",
        "requiredFiles",
        "registeredScripts",
        "requiredTarballs",
        "doctorRequiredFiles",
        "excludedFiles",
        "allowedMissingScripts"
      ],
      "properties": {
        "profileId": { "type": "string", "minLength": 1 },
        "mode": { "enum": ["host-integration", "rules-only", "legacy-host-compatible"] },
        "syncProfile": { "enum": ["minimal", "workbench"] },
        "syncManifestPath": { "$ref": "#/$defs/relativePath" },
        "requiredFiles": {
          "type": "array",
          "items": { "$ref": "#/$defs/relativePath" },
          "uniqueItems": true
        },
        "registeredScripts": { "$ref": "#/$defs/scriptMap" },
        "requiredTarballs": {
          "type": "array",
          "items": { "$ref": "#/$defs/relativePath" },
          "uniqueItems": true
        },
        "dependencySpecs": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "doctorRequiredFiles": {
          "type": "array",
          "items": { "$ref": "#/$defs/relativePath" },
          "uniqueItems": true
        },
        "excludedFiles": {
          "type": "array",
          "items": { "$ref": "#/$defs/relativePath" },
          "uniqueItems": true
        },
        "allowedMissingScripts": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      }
    }
  }
}
