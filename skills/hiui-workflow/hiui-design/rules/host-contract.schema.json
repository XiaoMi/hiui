{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hiui-design.local/schemas/host-contract.schema.json",
  "title": "HiUI Design Legacy Host Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "mode",
    "hostId",
    "reactRuntime",
    "hiuiRuntime",
    "contentMount",
    "routeOwner",
    "outerPaddingOwner",
    "whiteBodyOwner",
    "mainScrollOwner",
    "portalRoot",
    "styleBoundary",
    "adapters"
  ],
  "properties": {
    "schemaVersion": { "const": "host-contract.v1" },
    "mode": { "const": "legacy-host-compatible" },
    "hostId": { "type": "string", "minLength": 1 },
    "source": { "type": "string" },
    "reactRuntime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["packageName", "versionRange", "major"],
      "properties": {
        "packageName": { "const": "react" },
        "versionRange": { "type": "string", "minLength": 1 },
        "major": { "type": "integer", "minimum": 0 }
      }
    },
    "hiuiRuntime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rootPackage", "rootVersionRange"],
      "properties": {
        "rootPackage": { "type": "string", "minLength": 1 },
        "rootVersionRange": { "type": "string", "minLength": 1 },
        "hiui5Alias": { "type": "string" }
      }
    },
    "contentMount": {
      "type": "object",
      "additionalProperties": false,
      "required": ["selector", "owner"],
      "properties": {
        "selector": { "type": "string", "minLength": 1 },
        "owner": { "enum": ["host", "hiui-page-boundary"] },
        "notes": { "type": "string" }
      }
    },
    "routeOwner": { "enum": ["host", "hiui-page-boundary"] },
    "outerPaddingOwner": { "enum": ["host", "hiui-page-boundary", "none"] },
    "whiteBodyOwner": { "enum": ["host", "hiui-page-boundary", "typical-page-shell"] },
    "mainScrollOwner": { "enum": ["host", "hiui-page-boundary", "typical-page-shell"] },
    "portalRoot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["selector", "owner"],
      "properties": {
        "selector": { "type": "string", "minLength": 1 },
        "owner": { "enum": ["host", "hiui-page-boundary"] }
      }
    },
    "styleBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scopeAttribute", "tokenSource", "globalCssIsolation"],
      "properties": {
        "scopeAttribute": { "type": "string", "minLength": 1 },
        "tokenSource": { "type": "string", "minLength": 1 },
        "globalCssIsolation": { "type": "boolean" }
      }
    },
    "adapters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request", "message", "permission", "route", "theme"],
      "properties": {
        "request": { "$ref": "#/$defs/adapter" },
        "message": { "$ref": "#/$defs/adapter" },
        "permission": { "$ref": "#/$defs/adapter" },
        "route": { "$ref": "#/$defs/adapter" },
        "theme": { "$ref": "#/$defs/adapter" },
        "i18n": { "$ref": "#/$defs/adapter" }
      }
    }
  },
  "$defs": {
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "source"],
      "properties": {
        "status": { "enum": ["ready", "missing", "partial", "not-required"] },
        "source": { "type": "string" },
        "notes": { "type": "string" }
      }
    }
  }
}
