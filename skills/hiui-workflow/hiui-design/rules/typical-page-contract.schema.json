{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hiui-design.local/schemas/typical-page-contract.schema.json",
  "title": "HiUI Design Typical Page Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "pageTypeId",
    "baseMoldId",
    "shell",
    "sourceDocs",
    "regions",
    "regionOrder",
    "ownership",
    "slotSchema",
    "componentSources",
    "visualTokens",
    "forbiddenOverrides",
    "verificationRules"
  ],
  "properties": {
    "schemaVersion": { "const": "typical-page-contract.v1" },
    "pageTypeId": { "type": "string", "minLength": 1 },
    "baseMoldId": { "type": "string", "minLength": 1 },
    "shell": { "type": "string", "minLength": 1 },
    "sourceDocs": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1, "uniqueItems": true },
    "regions": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1, "uniqueItems": true },
    "regionOrder": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1 },
    "ownership": {
      "type": "object",
      "additionalProperties": { "enum": ["host", "hiui-page-boundary", "typical-page-shell", "managed-component"] },
      "minProperties": 1
    },
    "slotSchema": {
      "type": "object",
      "additionalProperties": false,
      "required": ["editableSlots", "slotManifest"],
      "properties": {
        "editableSlots": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1, "uniqueItems": true },
        "slotManifest": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["slotId", "contentType", "allowedChanges", "forbiddenChanges"],
            "properties": {
              "slotId": { "type": "string", "minLength": 1 },
              "label": { "type": "string" },
              "contentType": { "type": "string", "minLength": 1 },
              "allowedChanges": { "type": "array", "items": { "type": "string" } },
              "forbiddenChanges": { "type": "array", "items": { "type": "string" } }
            }
          }
        }
      }
    },
    "componentSources": {
      "type": "object",
      "additionalProperties": { "type": "string" },
      "minProperties": 1
    },
    "visualTokens": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "tokenSource", "forbidPageLocalOverrides"],
      "properties": {
        "scope": { "type": "string", "minLength": 1 },
        "tokenSource": { "type": "string", "minLength": 1 },
        "forbidPageLocalOverrides": { "type": "array", "items": { "type": "string" } }
      }
    },
    "forbiddenOverrides": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "allowedExtensions": { "type": "array", "items": { "type": "string" } },
    "verificationRules": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1 }
  }
}
